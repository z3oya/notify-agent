<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NotifyAgent.WinUI3.FloatingBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="notify-agent 悬浮条">

  <Grid Padding="14,10" ColumnSpacing="8" VerticalAlignment="Center">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <TextBlock Text="悬浮窗示例" VerticalAlignment="Center" />
    <Button Grid.Column="1" Padding="5" Click="OnCloseClick">
      <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="12" Glyph="&#xE711;" />
    </Button>
  </Grid>
</Window>
