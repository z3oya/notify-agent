<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NotifyAgent.WinUI3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tb="using:H.NotifyIcon"
    mc:Ignorable="d"
    Title="notify-agent">

  <Grid x:Name="RootGrid">
    <Grid.RenderTransform>
      <TranslateTransform x:Name="RootTranslate" />
    </Grid.RenderTransform>

    <StackPanel Margin="16" Spacing="14" MaxWidth="400">

      <TextBlock Text="示例组件" Style="{ThemeResource SubtitleTextBlockStyle}" />

      <InfoBar
          IsOpen="True"
          IsClosable="False"
          Severity="Informational"
          Title="notify-agent"
          Message="WinUI3 示例窗口" />

      <TextBox Header="名称" PlaceholderText="在此输入" />

      <ComboBox Header="优先级" PlaceholderText="选择一项" SelectedIndex="1" MinWidth="200">
        <ComboBoxItem>低</ComboBoxItem>
        <ComboBoxItem>中</ComboBoxItem>
        <ComboBoxItem>高</ComboBoxItem>
      </ComboBox>

      <ToggleSwitch x:Name="FloatingToggle" Header="悬浮窗" OnContent="开" OffContent="关" Toggled="OnFloatingToggled" />

      <CheckBox Content="开机自启" />

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="标准按钮" />
        <Button Content="强调按钮" Style="{ThemeResource AccentButtonStyle}" />
      </StackPanel>

    </StackPanel>

    <tb:TaskbarIcon
        x:Name="TrayIcon"
        IconSource="ms-appx:///Assets/app.ico"
        ToolTipText="notify-agent"
        ContextMenuMode="PopupMenu"
        PopupActivation="None"
        NoLeftClickDelay="True" />
  </Grid>
</Window>
