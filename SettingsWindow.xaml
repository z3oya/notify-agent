<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NotifyAgent.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="设置">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20" Spacing="14">

      <InfoBar
          IsOpen="True"
          IsClosable="False"
          Severity="Informational"
          Title="示例设置"
          Message="此窗口为占位示例,更改不会保存。" />

      <ComboBox Header="主题" PlaceholderText="选择一项" SelectedIndex="0" MinWidth="200">
        <ComboBoxItem>跟随系统</ComboBoxItem>
        <ComboBoxItem>浅色</ComboBoxItem>
        <ComboBoxItem>深色</ComboBoxItem>
      </ComboBox>

      <ToggleSwitch Header="开机自启" OnContent="开" OffContent="关" />

      <Slider Header="通知显示时长(秒)" Minimum="3" Maximum="15" Value="5" StepFrequency="1" />

      <TextBox Header="通知来源过滤" PlaceholderText="示例:仅标题匹配" />

    </StackPanel>
  </ScrollViewer>
</Window>
